--
-- Table structure for table `inventory`
--

CREATE TABLE `inventory` (
  `id` int(11) NOT NULL,
  `agency_id` int(11) NOT NULL,
  `item_id` int(11) NOT NULL,
  `current_quantity` int(11) NOT NULL DEFAULT 0,
  `reserved_quantity` int(11) DEFAULT 0,
  `reorder_level` int(11) DEFAULT 0,
  `average_cost` decimal(10,2) DEFAULT NULL,
  `last_purchase_cost` decimal(10,2) DEFAULT NULL,
  `last_stock_in_date` datetime DEFAULT NULL,
  `last_stock_out_date` datetime DEFAULT NULL,
  `status` enum('ACTIVE','OUT_OF_STOCK') DEFAULT 'ACTIVE',
  `created_at` timestamp NULL DEFAULT current_timestamp(),
  `updated_at` timestamp NULL DEFAULT current_timestamp() ON UPDATE current_timestamp()
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci;

