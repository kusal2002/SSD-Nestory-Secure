-- --------------------------------------------------------

--
-- Table structure for table `item_master`
--

CREATE TABLE `item_master` (
  `id` int(11) NOT NULL,
  `agency_id` int(11) NOT NULL,
  `supplier_id` int(11) DEFAULT NULL,
  `item_code` varchar(50) NOT NULL,
  `item_name` varchar(255) NOT NULL,
  `category` varchar(100) DEFAULT NULL,
  `brand` varchar(100) DEFAULT NULL,
  `unit` varchar(20) NOT NULL,
  `unit_size` decimal(10,2) DEFAULT NULL,
  `buying_price` decimal(10,2) NOT NULL,
  `selling_price_1` decimal(10,2) NOT NULL,
  `selling_price_2` decimal(10,2) DEFAULT NULL,
  `selling_price_3` decimal(10,2) DEFAULT NULL,
  `tax_rate` decimal(5,2) DEFAULT 0.00,
  `barcode` varchar(100) DEFAULT NULL,
  `image_url` varchar(255) DEFAULT NULL,
  `is_expirable` tinyint(1) DEFAULT 0,
  `shelf_life_days` int(11) DEFAULT NULL,
  `current_quantity` decimal(10,2) DEFAULT 0.00,
  `status` enum('ACTIVE','INACTIVE') DEFAULT 'ACTIVE',
  `created_at` timestamp NULL DEFAULT current_timestamp(),
  `updated_at` timestamp NULL DEFAULT current_timestamp() ON UPDATE current_timestamp()
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci;

