--
-- Table structure for table `employees`
--

CREATE TABLE `employees` (
  `id` int(11) NOT NULL,
  `agency_id` int(11) NOT NULL,
  `employee_code` varchar(50) NOT NULL,
  `first_name` varchar(150) NOT NULL,
  `last_name` varchar(150) NOT NULL,
  `employee_type` enum('STAFF','STORE_MANAGER','ASSISTANT_MANAGER','CASHIER','SALES_ASSISTANT','INVENTORY_OFFICER','WAREHOUSE_STAFF','DRIVER','DRIVER_HELPER','ACCOUNTANT','PURCHASING_OFFICER','CLEANER','SECURITY','IT_OPERATOR') NOT NULL DEFAULT 'STAFF',
  `license_number` varchar(100) NOT NULL,
  `phone` varchar(20) DEFAULT NULL,
  `status` enum('ACTIVE','INACTIVE') DEFAULT 'ACTIVE',
  `created_at` timestamp NOT NULL DEFAULT current_timestamp()
) ENGINE=MyISAM DEFAULT CHARSET=latin1 COLLATE=latin1_swedish_ci;

--
-- Dumping data for table `employees`
--

