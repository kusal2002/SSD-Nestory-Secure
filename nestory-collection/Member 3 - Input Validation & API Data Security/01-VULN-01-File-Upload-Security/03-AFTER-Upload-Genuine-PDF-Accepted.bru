meta {
  name: 03. AFTER - Upload Legitimate PDF (Accepted 201)
  type: http
  seq: 3
}

post {
  url: http://localhost:5050/api/stories
  body: multipartForm
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:multipart-form {
  title: Legitimate Story Book
  author: Genuine Author
  description: Testing valid PDF upload
  ageGroup: middle-grade
  readingLevel: beginner
  genres: ["adventure"]
  pdf: @file(payloads/p&l report.pdf) @contentType(application/pdf)
}

