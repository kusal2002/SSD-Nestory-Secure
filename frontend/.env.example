# Prefer same-origin `/api` in dev so the Vite proxy talks to the backend (avoids cross-origin + tracking-prevention noise).
# VITE_API_URL=/api
#
# Direct backend URL (different port than the app — some browsers may warn about storage / third-party context):
VITE_API_URL=http://localhost:5000/api

# --- Google Books (pick one approach; defaults try JS viewer, then auto-fallback) ---
#
# No embed on Nestory at all — link opens in new tab, you log pages here (no Google iframe/JS):
# VITE_GOOGLE_BOOKS_DISABLE_EMBED=true
#
# Skip JS viewer; use simple embed iframe only (+1 page logging):
# VITE_GOOGLE_BOOKS_IFRAME_ONLY=true
#
# Auto-switch to simple embed if JS viewer not ready (ms). Omit = 8000. Use 0 to disable auto-switch:
# VITE_GOOGLE_BOOKS_AUTO_IFRAME_FALLBACK_MS=0
