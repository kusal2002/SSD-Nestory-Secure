# Server Configuration
PORT=5000
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:5173

# Database Configuration
MONGO_URI=mongodb://localhost:27017/nestory

# JWT Configuration
JWT_SECRET=REPLACE_WITH_YOUR_OWN_SECRET
JWT_EXPIRE=1d

# CORS Configuration
CLIENT_URL=http://localhost:3000

# AI Challenge Configuration
# Provider priority for Daily AI Challenge:
# 1) Gemini (if GEMINI_API_KEY is set)
# 2) OpenAI (if OPENAI_API_KEY is set)
# 3) Local fallback challenge template
GEMINI_API_KEY=api_key_here
GEMINI_MODEL=gemini-1.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini


# WSO2 OpenID Connect
WSO2_BASE_URL=https://localhost:9443
WSO2_CLIENT_ID=your_wso2_client_id
WSO2_CLIENT_SECRET=your_wso2_client_secret
WSO2_REDIRECT_URI=http://localhost:5000/api/auth/oidc/callback
WSO2_FRONTEND_URL=http://localhost:5173